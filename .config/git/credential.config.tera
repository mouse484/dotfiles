[credential]
  helper =
{% if os() == "macos" %}
  helper = /usr/local/share/gcm-core/git-credential-manager
{% elif get_env(name="WSL_DISTRO_NAME", default="") != "" %}
{% if "/mnt/c/Program Files/Git/ucrt64/bin/git-credential-manager.exe" is file %}
  helper = /mnt/c/Program\\ Files/Git/ucrt64/bin/git-credential-manager.exe
{% elif "/mnt/c/Program Files/Git/mingw64/bin/git-credential-manager.exe" is file %}
  helper = /mnt/c/Program\\ Files/Git/mingw64/bin/git-credential-manager.exe
{% elif "/mnt/c/Program Files/Git/clangarm64/bin/git-credential-manager.exe" is file %}
  helper = /mnt/c/Program\\ Files/Git/clangarm64/bin/git-credential-manager.exe
{% else %}
{{ throw(message="Git Credential Manager from Git for Windows was not found") }}
{% endif %}
{% else %}
  helper = manager
{% endif %}
