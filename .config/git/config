[init]
  defaultBranch = main

[credential]
  useHttpPath = true
  helper =
  helper = manager
  helper = manager.exe
  helper = {{ os(macos="osxkeychain", linux="cache", windows="wincred") }}
  credentialStore = {{ os(macos="keychain", linux="cache", windows="wincredman") }}

[ghq]
  root = ~/src

[includeIf "gitdir:~/src/github.com/mouse484/"]
  path = ./conf.d/mouse484

[include]
  path = ./config.local
